# ---- Stages 3 & 4 - Qwen2.5-7B-Instruct via OpenRouter   (openrouter.ai/keys) -------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-7b-instruct
# json_object (default) | json_schema | none
LLM_JSON_MODE=json_object

# Optional - shown on openrouter.ai rankings
# OPENROUTER_SITE_URL=https://your-site.example
# OPENROUTER_APP_NAME=AI Meeting Assistant

# ---- Stage 1 - WhisperX transcription (runs on THIS machine, no API key needed) -----------------
# auto = large-v3-turbo on an NVIDIA GPU, small.en on a CPU.
# Lighter / faster: tiny.en, base.en    Better / slower on CPU: medium.en, large-v3-turbo
# WHISPERX_MODEL=auto
# auto | cuda | cpu
# WHISPERX_DEVICE=auto
# auto | float16 | int8_float16 | int8 | float32     (auto: float16 on GPU, int8 on CPU)
# WHISPERX_COMPUTE=auto
# Whisper batch size. Lower it (2-4) if you run out of memory. auto: 16/8/4 by GPU memory, 4 on CPU
# WHISPERX_BATCH=auto
# Voice-activity detector: pyannote (default) | silero
# WHISPERX_VAD=pyannote
# CPU threads (auto = all cores but one, max 8). Lower this to keep the PC responsive while it runs.
# WHISPERX_THREADS=auto

# ---- Stage 2 - speaker diarization (optional; WhisperX runs pyannote community-1 internally) ------
# Hugging Face READ token: https://huggingface.co/settings/tokens
# You must ALSO click "Agree and access repository" (same account) on:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# auto | cuda | cpu
# DIARIZATION_DEVICE=auto

# ---- Long meetings (optional) ----------------------------------------------------------------------
# Transcripts longer than this many characters are summarised in parts and merged.
# 30000 chars ~ 7-8k tokens, which suits a 7B model; raise it if you switch to a bigger LLM.
# EXTRACT_SINGLE_PASS_CHARS=30000
# EXTRACT_CHUNK_CHARS=20000
